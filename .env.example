# Copy to .env next to docker-compose.yml and fill in. Lines starting with # are comments.

# --- Required ---------------------------------------------------------------------------------------------------

# Password of the first admin account: at least 12 characters, at most 72 bytes.
# Only read while no users exist, so changing it later does not change an existing password.
CENTRY_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Pinned image tag to run, e.g. sha-<40 hex> from the Deploy workflow. Never "latest".
# scripts/upgrade.sh rewrites this line when you upgrade.
CENTRY_TAG=

# --- Optional (the value shown is the default) ------------------------------------------------------------------

# Username of the first admin account.
#CENTRY_ADMIN_USERNAME=admin

# Image repository. Forks change this.
#CENTRY_IMAGE=ghcr.io/sfredr01/centry

# Host directory mounted at /data (database and backups). Must be owned by 10001:10001:
#   sudo mkdir -p /opt/centry/data && sudo chown -R 10001:10001 /opt/centry/data
#CENTRY_DATA=/opt/centry/data

# Host port the app listens on.
#CENTRY_PORT=8080

# Household time zone, e.g. America/Chicago. Decides which calendar month budgets belong to. The app clock follows
# it; CENTRY_ZONE (centry.zone) overrides only the app clock and is rarely needed.
#TZ=UTC

# Push notifications through ntfy. A channel is on only when its URL (and for ntfy the topic) is set.
#CENTRY_NOTIFY_NTFY_URL=https://ntfy.sh
#CENTRY_NOTIFY_NTFY_TOPIC=
#CENTRY_NOTIFY_NTFY_TOKEN=

# Discord/Slack-style webhook.
#CENTRY_NOTIFY_WEBHOOK_URL=

# Set to true when the app is served over HTTPS (Tailscale, Caddy). Leave false for plain HTTP on the LAN.
#SERVER_SERVLET_SESSION_COOKIE_SECURE=false
